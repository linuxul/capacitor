{
  "name": "capacitor",
  "private": true,
  "workspaces": [
    "android",
    "ios",
    "cli",
    "core"
  ],
  "scripts": {
    "build:nativebridge": "lerna run build:nativebridge",
    "sync-peer-dependencies": "node scripts/sync-peer-dependencies.mjs",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint && npm run ktlint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format && npm run ktlint -- --format",
    "prettier": "prettier \"**/*.{css,html,js,mjs,ts}\"",
    "eslint": "eslint . --ext ts",
    "swiftlint": "node-swiftlint",
    "ktlint": "ktlint \"android/capacitor/src/**/*.kt\" \"android-template/**/*.kt\" \"!**/build/**\"",
    "version": "npm run sync-peer-dependencies"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "devDependencies": {
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "18.18.6",
    "eslint": "^8.57.0",
    "lerna": "^7.1.3",
    "prettier": "^3.3.0",
    "rimraf": "^4.4.1",
    "semver": "^7.3.7",
    "swiftlint": "^2.0.0",
    "tar": "^7.5.3"
  }
}
